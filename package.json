{
  "name": "design-system",
  "version": "0.0.0",
  "private": true,
  "keywords": [
    "Orfium",
    "design system",
    "emotion",
    "react",
    "styled-system",
    "typescript"
  ],
  "homepage": "https://github.com/Orfium/orfium-ictinus#readme",
  "bugs": {
    "url": "https://github.com/Orfium/orfium-ictinus/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orfium/orfium-ictinus.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "tsc": "turbo tsc",
    "lint": "turbo lint",
    "test": "turbo test",
    "check": "pnpm fmt:check && turbo run check",
    "precommit": "pnpm fmt:check && turbo run precommit --affected",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "coverage:report": "turbo build --filter='./packages/*' && vitest run --coverage",
    "release": "turbo run build --filter='./packages/*' && changeset publish",
    "release:experimental": "turbo run build --filter='./packages/*' && changeset publish --tag experimental"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "husky": "^9.1.7",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.67.0",
    "turbo": "^2.10.0",
    "typescript": "^5.9.2",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.16.1"
}
