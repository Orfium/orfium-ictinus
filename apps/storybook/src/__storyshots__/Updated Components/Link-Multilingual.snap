.emotion-0 {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
  -ms-flex-direction: column;
  flex-direction: column;
  -webkit-box-flex-wrap: wrap;
  -webkit-flex-wrap: wrap;
  -ms-flex-wrap: wrap;
  flex-wrap: wrap;
}

.emotion-1 {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  gap: var(--ictinus-spacing-3);
  color: var(--ictinus-color-text-default-active);
  -webkit-text-decoration: none;
  text-decoration: none;
  position: relative;
  opacity: 1;
  -webkit-align-items: center;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  cursor: pointer;
  pointer-events: auto;
  font-family: Roboto,system-ui,sans-serif;
  font-weight: 500;
  line-height: 1.375rem;
  font-size: 1rem;
  letter-spacing: 0.00625rem;
}

.emotion-1:hover,
.emotion-1[aria-expanded='true'] {
  color: var(--ictinus-color-text-default-primary);
}

.emotion-1:hover path,
.emotion-1[aria-expanded='true'] path {
  fill: var(--ictinus-color-text-default-primary)!important;
}

.emotion-1:visited {
  color: var(--ictinus-color-text-default-visited);
}

.emotion-1:visited path {
  fill: var(--ictinus-color-text-default-visited)!important;
}

.emotion-1:focus-visible:after {
  content: '';
  position: absolute;
  inset: -3px -6px;
  border-radius: var(--ictinus-border-radius-2);
  border: var(--ictinus-border-width-3) solid var(--ictinus-color-border-color-interactive-upsell);
}

.emotion-8 {
  display: -webkit-inline-box;
  display: -webkit-inline-flex;
  display: -ms-inline-flexbox;
  display: inline-flex;
  gap: var(--ictinus-spacing-3);
  color: var(--ictinus-color-text-default-active);
  -webkit-text-decoration: none;
  text-decoration: none;
  position: relative;
  opacity: 1;
  -webkit-align-items: center;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  cursor: pointer;
  pointer-events: auto;
  font-family: var(--ictinus-font-sans);
  -webkit-text-decoration: underline;
  text-decoration: underline;
  font-weight: var(--ictinus-weight-medium);
  font-size: var(--ictinus-font-size-3);
  line-height: var(--ictinus-line-height-4);
  letter-spacing: var(--ictinus-letter-spacing-2);
}

.emotion-8:hover,
.emotion-8[aria-expanded='true'] {
  color: var(--ictinus-color-text-default-primary);
}

.emotion-8:hover path,
.emotion-8[aria-expanded='true'] path {
  fill: var(--ictinus-color-text-default-primary)!important;
}

.emotion-8:visited {
  color: var(--ictinus-color-text-default-visited);
}

.emotion-8:visited path {
  fill: var(--ictinus-color-text-default-visited)!important;
}

.emotion-8:focus-visible:after {
  content: '';
  position: absolute;
  inset: -3px -6px;
  border-radius: var(--ictinus-border-radius-2);
  border: var(--ictinus-border-width-3) solid var(--ictinus-color-border-color-interactive-upsell);
}

<div>
  <div
    class="emotion-0"
  >
    <div
      style="margin: 5px;"
    >
      <a
        class="emotion-1"
        data-slot="link"
        data-testid="_link"
        href="#"
      >
        Hello
      </a>
    </div>
    <div
      style="margin: 5px;"
    >
      <a
        class="emotion-1"
        data-slot="link"
        data-testid="_link"
        href="#"
      >
        Привет
      </a>
    </div>
    <div
      style="margin: 5px;"
    >
      <a
        class="emotion-1"
        data-slot="link"
        data-testid="_link"
        href="#"
      >
        Γεια σας
      </a>
    </div>
    <div
      style="margin: 5px;"
    >
      <a
        class="emotion-1"
        data-slot="link"
        data-testid="_link"
        href="#"
      >
        Cześć Łódź
      </a>
    </div>
    <div
      style="margin: 5px;"
    >
      <a
        class="emotion-1"
        data-slot="link"
        data-testid="_link"
        href="#"
      >
        Xin chào
      </a>
    </div>
    <div
      style="margin: 5px;"
    >
      <a
        class="emotion-1"
        data-slot="link"
        data-testid="_link"
        href="#"
      >
        こんにちは
      </a>
    </div>
    <div
      style="margin: 5px;"
    >
      <a
        class="emotion-1"
        data-slot="link"
        data-testid="_link"
        href="#"
      >
        你好
      </a>
    </div>
    <div
      style="margin: 5px;"
    >
      <div>
        Inline:
         
        <a
          class="emotion-8"
          data-slot="link"
          data-testid="_link"
          href="#"
        >
          English
        </a>
        , 
        <a
          class="emotion-8"
          data-slot="link"
          data-testid="_link"
          href="#"
        >
          Русский
        </a>
        , 
        <a
          class="emotion-8"
          data-slot="link"
          data-testid="_link"
          href="#"
        >
          Ελληνικά
        </a>
        , 
        <a
          class="emotion-8"
          data-slot="link"
          data-testid="_link"
          href="#"
        >
          Polski Łódź
        </a>
      </div>
    </div>
  </div>
</div>