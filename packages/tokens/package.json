{
  "name": "@orfium/tokens",
  "version": "5.2.2",
  "homepage": "https://github.com/Orfium/orfium-ictinus/tree/master/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/Orfium/orfium-ictinus/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orfium/orfium-ictinus.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist/**",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.css.ts"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./vars.css": "./dist/vars.css"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "vite build",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:update": "vitest -u",
    "lint": "oxlint",
    "tsc": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm tsc && pnpm lint && pnpm fmt:check",
    "precommit": "pnpm tsc && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@vanilla-extract/css": "^1.17.4",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "lodash-es": "^4.18.1",
    "polished": "^4.3.1",
    "postcss-pxtorem": "^6.1.0",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
